<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>BragaNet</RootNamespace>
    <AssemblyName>Braga</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <PackageId>Braga</PackageId>
    <Version>0.1.0</Version>
    <Authors>bRAGa contributors</Authors>
    <Description>Typed .NET binding over the bRAGa C ABI (version 1).</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/artemidius/braga</RepositoryUrl>
    <RuntimeIdentifiers>win-x64;osx-x64;osx-arm64;linux-x64;linux-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Braga.Tests" />
  </ItemGroup>

  <!-- The cdylibs are generated by build.sh under dotnet/runtimes/. The auto-generated Link
       metadata supplies <rid>/native/<file>, completing runtimes/<rid>/native/ in the package. -->
  <ItemGroup>
    <None Include="../../runtimes/**/native/*" Pack="true" PackagePath="runtimes/" />
  </ItemGroup>

</Project>
